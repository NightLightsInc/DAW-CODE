<style>
  #web-daw {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #12131a;
    color: #f1f5f9;
    border: 1px solid #2a2d3d;
    border-radius: 12px;
    padding: 20px;
    max-width: 900px;
    margin: 0 auto;
    box-sizing: border-box;
  }
  #web-daw * { box-sizing: border-box; }
  .daw-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid #2a2d3d;
    margin-bottom: 18px;
  }
  .daw-title {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #38bdf8;
  }
  .transport {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .daw-btn {
    background: #1e2130;
    color: #f1f5f9;
    border: 1px solid #33384d;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .daw-btn:hover { background: #2b3045; }
  .daw-btn.play.active { background: #10b981; color: #06281e; border-color: #10b981; }
  .daw-btn.rec.active { background: #ef4444; color: #fff; border-color: #ef4444; animation: pulse 1.2s infinite; }
  .daw-btn.export { background: #6366f1; border-color: #6366f1; }
  .daw-btn.export:hover { background: #4f46e5; }
  .daw-btn.popout { background: #0284c7; border-color: #0284c7; }
  .bpm-box {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #1e2130;
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid #33384d;
    font-size: 0.85rem;
  }
  .bpm-box input {
    width: 52px;
    background: transparent;
    border: none;
    color: #38bdf8;
    font-weight: 700;
    font-size: 0.9rem;
    text-align: center;
  }
  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #94a3b8;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .sequencer {
    background: #181a24;
    border: 1px solid #262938;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 18px;
    overflow-x: auto;
  }
  .seq-row {
    display: grid;
    grid-template-columns: 70px repeat(8, 1fr);
    gap: 6px;
    align-items: center;
    margin-bottom: 6px;
    min-width: 460px;
  }
  .seq-row:last-child { margin-bottom: 0; }
  .seq-name { font-size: 0.8rem; font-weight: 600; color: #cbd5e1; }
  .step {
    height: 30px;
    background: #222536;
    border: 1px solid #32364d;
    border-radius: 4px;
    cursor: pointer;
  }
  .step.on { background: #38bdf8; border-color: #7dd3fc; }
  .step.current { outline: 2px solid #facc15; }
  .track-list { display: flex; flex-direction: column; gap: 10px; }
  .track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #181a24;
    border: 1px solid #262938;
    border-radius: 8px;
    padding: 12px;
  }
  .track-info { display: flex; align-items: center; gap: 10px; min-width: 160px; }
  .track-name { font-weight: 600; font-size: 0.9rem; }
  .track-status { font-size: 0.78rem; color: #94a3b8; }
  .track-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .vol-slider { width: 85px; accent-color: #38bdf8; }
  #daw-msg { margin-top: 12px; font-size: 0.85rem; color: #facc15; min-height: 20px; font-weight: 500; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
</style>

<div id="web-daw">
  <div class="daw-header">
    <div class="daw-title">WEB STUDIO DAW</div>
    <div class="transport">
      <button id="btn-play" class="daw-btn play">Play</button>
      <button id="btn-stop" class="daw-btn">Stop</button>
      <div class="bpm-box">
        <span>BPM</span>
        <input id="bpm-input" type="number" value="120" min="60" max="200">
      </div>
      <button id="btn-export" class="daw-btn export">Download Mix (.WAV)</button>
      <button id="btn-popout" class="daw-btn popout">Pop-Out Mic Mode ↗</button>
    </div>
  </div>

  <div class="section-label">Beat Sequencer (8-Step Drum Synth)</div>
  <div class="sequencer" id="sequencer"></div>

  <div class="section-label">Audio Tracks (Microphone Overdubbing)</div>
  <div class="track-list" id="track-list"></div>

  <div id="daw-msg">Initializing...</div>
</div>

<script>
(function() {
  var audioCtx = null;
  var isPlaying = false;
  var currentStep = 0;
  var stepTimer = null;
  var activeSources = [];
  var mediaRecorder = null;
  var recordingTrackIndex = null;

  var drumNames = ["Kick", "Snare", "Hi-Hat"];
  var pattern = new Array(3);
  pattern[0] = new Array(1, 0, 0, 0, 1, 0, 0, 0);
  pattern[1] = new Array(0, 0, 1, 0, 0, 0, 1, 0);
  pattern[2] = new Array(1, 1, 1, 1, 1, 1, 1, 1);

  var tracks = [
    { name: "Track 1 (Vocals)", buffer: null, volume: 0.9, muted: false },
    { name: "Track 2 (Guitar/Synth)", buffer: null, volume: 0.9, muted: false },
    { name: "Track 3 (Harmony)", buffer: null, volume: 0.9, muted: false }
  ];

  var msgEl = document.getElementById("daw-msg");
  function setMsg(txt) {
    if (msgEl) msgEl.textContent = txt;
  }

  function ensureAudio() {
    if (!audioCtx) {
      var AudioContextClass = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AudioContextClass();
    }
    if (audioCtx.state === "suspended") {
      audioCtx.resume();
    }
  }

  function playDrumSound(ctx, type, time) {
    if (type === 0) {
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(140, time);
      osc.frequency.exponentialRampToValueAtTime(42, time + 0.14);
      gain.gain.setValueAtTime(0.9, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.25);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(time);
      osc.stop(time + 0.25);
    } else if (type === 1) {
      var bufferSize = Math.floor(ctx.sampleRate * 0.15);
      var buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      var data = buffer.getChannelData(0);
      for (var i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }
      var noise = ctx.createBufferSource();
      noise.buffer = buffer;
      var filter = ctx.createBiquadFilter();
      filter.type = "highpass";
      filter.frequency.value = 900;
      var gain = ctx.createGain();
      gain.gain.setValueAtTime(0.55, time);
      gain.gain.exponentialRampToValueAtTime(0.01, time + 0.15);
      noise.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      noise.start(time);
    } else if (type === 2) {
      var bufferSize = Math.floor(ctx.sampleRate * 0.05);
      var buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      var data = buffer.getChannelData(0);
      for (var i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }
      var noise = ctx.createBufferSource();
      noise.buffer = buffer;
      var filter = ctx.createBiquadFilter();
      filter.type = "highpass";
      filter.frequency.value = 6000;
      var gain = ctx.createGain();
      gain.gain.setValueAtTime(0.25, time);
      gain.gain.exponentialRampToValueAtTime(0.01, time + 0.05);
      noise.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      noise.start(time);
    }
  }

  function renderSequencer() {
    var seqEl = document.getElementById("sequencer");
    seqEl.innerHTML = "";
    for (var rowIdx = 0; rowIdx < drumNames.length; rowIdx++) {
      (function(r) {
        var row = document.createElement("div");
        row.className = "seq-row";
        var label = document.createElement("div");
        label.className = "seq-name";
        label.textContent = drumNames[r];
        row.appendChild(label);

        for (var step = 0; step < 8; step++) {
          (function(s) {
            var cell = document.createElement("div");
            cell.className = "step" + (pattern[r][s] ? " on" : "");
            cell.setAttribute("data-step", s);
            cell.onclick = function() {
              pattern[r][s] = pattern[r][s] ? 0 : 1;
              cell.classList.toggle("on");
            };
            row.appendChild(cell);
          })(step);
        }
        seqEl.appendChild(row);
      })(rowIdx);
    }
  }

  function renderTracks() {
    var listEl = document.getElementById("track-list");
    listEl.innerHTML = "";
    for (var idx = 0; idx < tracks.length; idx++) {
      (function(i) {
        var t = tracks[i];
        var row = document.createElement("div");
        row.className = "track";

        var info = document.createElement("div");
        info.className = "track-info";
        var statusTxt = t.buffer ? t.buffer.duration.toFixed(1) + "s recorded" : "Empty";
        info.innerHTML = '<div><div class="track-name">' + t.name + '</div><div class="track-status">' + statusTxt + '</div></div>';

        var ctrls = document.createElement("div");
        ctrls.className = "track-controls";

        var recBtn = document.createElement("button");
        recBtn.className = "daw-btn rec" + (recordingTrackIndex === i ? " active" : "");
        recBtn.textContent = recordingTrackIndex === i ? "Stop Rec" : "Record";
        recBtn.onclick = function() { toggleRecord(i); };

        var muteBtn = document.createElement("button");
        muteBtn.className = "daw-btn";
        muteBtn.textContent = t.muted ? "Unmute" : "Mute";
        muteBtn.onclick = function() {
          t.muted = !t.muted;
          renderTracks();
        };

        var vol = document.createElement("input");
        vol.type = "range";
        vol.className = "vol-slider";
        vol.min = 0;
        vol.max = 1;
        vol.step = 0.05;
        vol.value = t.volume;
        vol.oninput = function(e) { t.volume = parseFloat(e.target.value); };

        var clearBtn = document.createElement("button");

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NightLights Studio DAW</title>
  <style>
    :root {
      --bg: #0f111a;
      --panel: #1a1d2d;
      --accent: #7c4dff;
      --accent-hover: #9670ff;
      --record: #ff3b5c;
      --text: #f0f2f8;
      --muted: #8b92a8;
      --step-off: #262a40;
      --step-on: #00e5ff;
    }
    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
    body {
      margin: 0;
      padding: 16px;
      background: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .header, .panel {
      background: var(--panel);
      border-radius: 10px;
      padding: 14px 18px;
      border: 1px solid #2a2f47;
    }
    .header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .title { font-weight: 700; font-size: 1.1rem; letter-spacing: 0.5px; }
    .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    button {
      background: var(--accent);
      color: #fff;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.15s;
    }
    button:hover { background: var(--accent-hover); }
    button:disabled { opacity: 0.4; cursor: not-allowed; }
    button.rec { background: var(--record); }
    button.rec.active { animation: pulse 1s infinite; }
    button.secondary { background: #2d324d; }
    button.secondary:hover { background: #3b4263; }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(255, 59, 92, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(255, 59, 92, 0); }
      100% { box-shadow: 0 0 0 0 rgba(255, 59, 92, 0); }
    }
    input[type="number"] {
      width: 65px;
      background: #0f111a;
      color: var(--text);
      border: 1px solid #353b59;
      border-radius: 6px;
      padding: 6px 8px;
      font-weight: 600;
    }
    canvas {
      width: 100%;
      height: 70px;
      background: #0b0d14;
      border-radius: 6px;
      display: block;
      margin-top: 10px;
    }
    .seq-row {
      display: grid;
      grid-template-columns: 70px repeat(16, 1fr);
      gap: 5px;
      align-items: center;
      margin-bottom: 8px;
    }
    .seq-label { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
    .step {
      aspect-ratio: 1;
      background: var(--step-off);
      border-radius: 4px;
      cursor: pointer;
      border: 1px solid transparent;
    }
    .step.active { background: var(--step-on); box-shadow: 0 0 8px rgba(0, 229, 255, 0.4); }
    .step.playing { border-color: #fff; transform: scale(1.08); }
    .tracks { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
    .track-item {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      background: #121521;
      padding: 10px 14px;
      border-radius: 8px;
      gap: 10px;
    }
    audio { height: 32px; max-width: 100%; }
    .status { font-size: 0.85rem; color: var(--muted); }
  </style>
</head>
<body>

  <!-- Transport & Master Controls -->
  <div class="header">
    <div class="title">STUDIO DAW</div>
    <div class="controls">
      <button id="playBtn">▶ Play All</button>
      <button id="stopBtn" class="secondary">■ Stop</button>
      <button id="recBtn" class="rec">● Record Mic</button>
      <label style="font-size:0.85rem;">BPM:
        <input type="number" id="bpmInput" value="120" min="60" max="200" />
      </label>
      <button id="popoutBtn" class="secondary" title="Open in full window">↗ Pop Out</button>
    </div>
  </div>

  <!-- Live Microphone & Visualizer -->
  <div class="panel">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <strong>Microphone Input & Live Monitor</strong>
      <span class="status" id="micStatus">Ready (Click Record Mic to grant permission)</span>
    </div>
    <canvas id="visualizer"></canvas>
  </div>

  <!-- 16-Step Drum Sequencer -->
  <div class="panel">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <strong>Beat Sequencer (16-Step)</strong>
      <button id="clearSeqBtn" class="secondary" style="padding:4px 10px; font-size:0.8rem;">Clear Grid</button>
    </div>
    <div id="sequencer"></div>
  </div>

  <!-- Recorded Vocal / Audio Takes -->
  <div class="panel">
    <strong>Recorded Takes</strong>
    <div class="tracks" id="trackList">
      <div class="status" id="emptyMsg">No recordings yet. Hit "● Record Mic" to lay down a track.</div>
    </div>
  </div>

<script>
  // --- Audio Context & Sequencer Setup ---
  const AudioCtx = window.AudioContext || window.webkitAudioContext;
  let audioCtx;
  let isPlaying = false;
  let currentStep = 0;
  let timerID = null;

  const instruments = ['Kick', 'Snare', 'Hi-Hat', 'Clap'];
  const grid = instruments.map(() => Array(16).fill(false));
  // Default basic beat pattern
  [0, 4, 8, 12].forEach(i => grid[0][i] = true);
  [4, 12].forEach(i => grid[1][i] = true);
  [0, 2, 4, 6, 8, 10, 12, 14].forEach(i => grid[2][i] = true);

  const seqContainer = document.getElementById('sequencer');
  instruments.forEach((name, rowIdx) => {
    const row = document.createElement('div');
    row.className = 'seq-row';
    const label = document.createElement('div');
    label.className = 'seq-label';
    label.textContent = name;
    row.appendChild(label);

    for (let col = 0; col < 16; col++) {
      const step = document.createElement('div');
      step.className = 'step' + (grid[rowIdx][col] ? ' active' : '');
      step.dataset.row = rowIdx;
      step.dataset.col = col;
      step.onclick = () => {
        grid[rowIdx][col] = !grid[rowIdx][col];
        step.classList.toggle('active');
      };
      row.appendChild(step);
    }
    seqContainer.appendChild(row);
  });

  function initAudio() {
    if (!audioCtx) audioCtx = new AudioCtx();
    if (audioCtx.state === 'suspended') audioCtx.resume();
  }

  // Synthesized Drum Sounds (Zero external files needed)
  function playDrum(type) {
    initAudio();
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    if (type === 'Kick') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(150, now);
      osc.frequency.exponentialRampToValueAtTime(0.01, now + 0.4);
      gain.gain.setValueAtTime(1, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.4);
    } else if (type === 'Snare' || type === 'Clap') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(type === 'Snare' ? 180 : 300, now);
      gain.gain.setValueAtTime(0.5, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.2);
    } else if (type === 'Hi-Hat') {
      osc.type = 'square';
      osc.frequency.setValueAtTime(800, now);
      gain.gain.setValueAtTime(0.15, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.08);
    }
  }

  function stepSequencer() {
    document.querySelectorAll('.step').forEach(s => s.classList.remove('playing'));
    document.querySelectorAll(`.step[data-col="${currentStep}"]`).forEach(s => s.classList.add('playing'));

    instruments.forEach((inst, idx) => {
      if (grid[idx][currentStep]) playDrum(inst);
    });

    currentStep = (currentStep + 1) % 16;
  }

  // --- Transport Controls ---
  const playBtn = document.getElementById('playBtn');
  const stopBtn = document.getElementById('stopBtn');
  const bpmInput = document.getElementById('bpmInput');

  playBtn.onclick = () => {
    if (isPlaying) return;
    initAudio();
    isPlaying = true;
    const interval = (60 / bpmInput.value / 4) * 1000;
    stepSequencer();
    timerID = setInterval(stepSequencer, interval);
    document.querySelectorAll('audio').forEach(a => { a.currentTime = 0; a.play(); });
  };

  stopBtn.onclick = () => {
    isPlaying = false;
    clearInterval(timerID);
    currentStep = 0;
    document.querySelectorAll('.step').forEach(s => s.classList.remove('playing'));
    document.querySelectorAll('audio').forEach(a => { a.pause(); a.currentTime = 0; });
  };

  document.getElementById('clearSeqBtn').onclick = () => {
    grid.forEach(r => r.fill(false));
    document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
  };

  document.getElementById('popoutBtn').onclick = () => {
    window.open(window.location.href, '_blank', 'width=900,height=700');
  };

  // --- Microphone Recording & Visualizer ---
  const recBtn = document.getElementById('recBtn');
  const micStatus = document.getElementById('micStatus');
  const trackList = document.getElementById('trackList');
  const canvas = document.getElementById('visualizer');
  const canvasCtx = canvas.getContext('2d');

  let mediaRecorder;
  let audioChunks = [];
  let isRecording = false;
  let takeCount = 0;

  recBtn.onclick = async () => {
    if (!isRecording) {
      try {
        initAudio();
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        visualize(stream);

        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];

        mediaRecorder.ondataavailable = e => {
          if (e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          const blob = new Blob(audioChunks, { type: 'audio/webm' });
          const url = URL.createObjectURL(blob);
          addTrack(url);
